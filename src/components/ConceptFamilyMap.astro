---
const { families = [], currentSlug } = Astro.props;

const groupMembers = (members = []) => {
  const groups = [];
  const byKey = new Map();
  for (const member of members) {
    if (!byKey.has(member.role_key)) {
      const group = { key: member.role_key, label: member.role_label, members: [] };
      byKey.set(member.role_key, group);
      groups.push(group);
    }
    byKey.get(member.role_key).members.push(member);
  }
  return groups;
};
---

{families.map((family) => {
  const groups = groupMembers(family.members);
  return (
    <section class="concept-family" id={`family-${family.slug}`}>
      <div class="family-head">
        <h2>{family.label}</h2>
      </div>
      <p class="family-description">{family.description}</p>

      <div class="family-flow" aria-label={`${family.label} concept map`}>
        {groups.map((group) => (
          <div class="role-column">
            <h3>{group.label}</h3>
            <div class="role-members">
              {group.members.map((member) => (
                <a
                  href={`/terms/${member.term_slug}/`}
                  class:list={["family-member", { current: member.term_slug === currentSlug }]}
                  aria-current={member.term_slug === currentSlug ? 'page' : undefined}
                  title={member.note || undefined}
                >
                  <strong>{member.term_label}</strong>
                  {member.note && <span>{member.note}</span>}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  );
})}

<style>
  .concept-family{margin:3rem 0}
  .family-head{border-top:1px solid var(--line-dark);border-bottom:1px solid var(--line);padding:.8rem 0}
  .family-head h2{margin:0;border:0;padding:0}
  .family-description{max-width:58rem;margin:.75rem 0 .9rem;color:var(--muted);font-size:.84rem}
  .family-flow{display:grid;grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));border-top:1px solid var(--line-dark);border-left:1px solid var(--line-dark);background:var(--paper-pale)}
  .role-column{min-width:0;border-right:1px solid var(--line-dark);border-bottom:1px solid var(--line-dark)}
  .role-column h3{margin:0;padding:.5rem .6rem;border-bottom:1px solid var(--line);font:700 .59rem/1.3 var(--font-ui,ui-sans-serif,system-ui,sans-serif);text-transform:uppercase;letter-spacing:.05em;background:var(--paper-deep)}
  .role-members{display:flex;flex-direction:column}
  .family-member{display:block;padding:.58rem .62rem;text-decoration:none;border-bottom:1px solid var(--line);color:inherit}.family-member:last-child{border-bottom:0}
  .family-member strong,.family-member span{display:block}.family-member strong{font-size:.8rem}.family-member span{margin-top:.2rem;color:var(--muted);font-size:.7rem;line-height:1.32}
  .family-member:hover{background:var(--paper-deep)}.family-member.current{box-shadow:inset 0 -3px 0 var(--ink);background:var(--paper-deep)}
  @media(max-width:760px){.family-flow{grid-template-columns:1fr}}
</style>
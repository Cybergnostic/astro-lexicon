---
import BaseLayout from '../layouts/BaseLayout.astro';
import LexiconDirectory from '../components/LexiconDirectory.astro';
import corpus from '../data/generated/corpus.json';

const { terms, authors, works, meta } = corpus;
---
<BaseLayout title="Astrological Lexicon — Dictionary of Traditional Astrology" description="A source-based historical dictionary of traditional astrological terms, techniques and doctrines.">
  <header class="library-hero">
    <div class="shell library-hero-grid">
      <div>
        <p class="library-hero-eyebrow"><span aria-hidden="true" class="hero-rule"></span> THE HISTORICAL ASTROLOGY REFERENCE</p>
        <h1>The language of<br/><em>traditional astrology.</em></h1>
        <p class="library-hero-deck">A scholarly lexicon of concepts, techniques and terminology from the ancient, medieval and early modern astrological traditions.</p>
        <a class="library-hero-jump" href="#dictionary-heading">Explore the dictionary <span aria-hidden="true">↘</span></a>
      </div>
      <aside class="library-hero-aside" aria-label="Reference collection">
        <div class="library-hero-rule"></div>
        <p class="library-hero-aside-title">AN OPEN REFERENCE WORK</p>
        <strong>{meta.terms}<span>entries</span></strong>
        <p>Definitions, technical distinctions and source-specific historical accounts.</p>
        <div class="library-hero-numbers">
          <div><b>{authors.length}</b><span>AUTHORS</span></div>
          <div><b>{meta.works}</b><span>WORKS</span></div>
        </div>
      </aside>
    </div>
  </header>
  <LexiconDirectory terms={terms} authors={authors} works={works} />
</BaseLayout>

---
const { profile } = Astro.props;

const signs = [
  ['aries','Aries','♈'],['taurus','Taurus','♉'],['gemini','Gemini','♊'],['cancer','Cancer','♋'],
  ['leo','Leo','♌'],['virgo','Virgo','♍'],['libra','Libra','♎'],['scorpio','Scorpio','♏'],
  ['sagittarius','Sagittarius','♐'],['capricorn','Capricorn','♑'],['aquarius','Aquarius','♒'],['pisces','Pisces','♓']
];

const quarterLabel = (value) => ({
  'march-equinox':'March-equinox quarter',
  'june-solstice':'June-solstice quarter',
  'september-equinox':'September-equinox quarter',
  'december-solstice':'December-solstice quarter'
}[value] ?? value);

const positionLabel = (value) => ({ beginning:'Beginning', middle:'Middle', closing:'Closing' }[value] ?? value);
const degreeLabel = (value) => Number(value).toLocaleString('en-US', { maximumFractionDigits: 2 });
---

{profile && <section class="sign-profile" id="sign-profile">
  <div class="profile-head">
    <div>
      <p class="micro-label">Normalized family reference</p>
      <h2>Zodiac sign profile</h2>
    </div>
    {profile.astronomy_source_label && profile.astronomy_source_url &&
      <a class="source-link" href={profile.astronomy_source_url} rel="noreferrer">Astronomy boundary reference · {profile.astronomy_source_label}</a>}
  </div>

  <ol class="zodiac-strip" aria-label="Twelve equal signs of the tropical zodiac">
    {signs.map(([slug,label,glyph], index) => <li class:list={{ current: index + 1 === profile.ordinal }} aria-current={index + 1 === profile.ordinal ? 'true' : undefined}>
      <a href={`/terms/${slug}/`} title={`${label}: ${index * 30}°–${(index + 1) * 30}°`}>
        <span class="strip-glyph" aria-hidden="true">{glyph}</span><span class="strip-name">{label}</span>
      </a>
    </li>)}
  </ol>

  <div class="profile-grid">
    <div><span>Position</span><strong>Sign {profile.ordinal} of 12</strong></div>
    <div><span>Tropical longitude</span><strong>{degreeLabel(profile.longitude_start)}°–{degreeLabel(profile.longitude_end)}°</strong></div>
    <div><span>Element / triplicity</span><strong><a href={`/terms/${profile.element_slug}/`}>{profile.element_label}</a></strong></div>
    <div><span>Modality</span><strong><a href={`/terms/${profile.modality_slug}/`}>{profile.modality_label}</a></strong></div>
    <div><span>Polarity class</span><strong><a href={`/terms/${profile.polarity_slug}/`}>{profile.polarity_label}</a></strong></div>
    <div><span>Day / night class</span><strong><a href={`/terms/${profile.day_night_slug}/`}>{profile.day_night_label}</a></strong></div>
    <div><span>Tropical quarter</span><strong>{quarterLabel(profile.quarter_anchor)} · {positionLabel(profile.quarter_position)}</strong></div>
    <div><span>Solar annual half</span><strong>Sun {profile.solar_declination_half} of the celestial equator between the boundary points</strong></div>
  </div>

  <div class="profile-notes">
    {profile.geometry_note && <p><strong>Geometry.</strong> {profile.geometry_note}</p>}
    {profile.tradition_note && <p><strong>Traditional taxonomy.</strong> {profile.tradition_note}</p>}
    <p><strong>Reading rule.</strong> These classifications are parallel systems, not a stack of personality keywords. Planetary dignities are rendered separately from the normalized dignity tables.</p>
  </div>
</section>}

<style>
  .sign-profile{margin:3rem 0}
  .profile-head{display:flex;gap:1.5rem;align-items:flex-end;justify-content:space-between;border-top:1px solid var(--line-dark);border-bottom:1px solid var(--line);padding:.8rem 0;margin-bottom:1rem}.profile-head h2{margin:.15rem 0 0;border:0;padding:0}
  .source-link{font-size:.74rem;color:var(--muted);text-align:right;max-width:26rem;text-decoration:none;border-bottom:1px dotted currentColor}.source-link:hover{border-bottom-style:solid}
  .zodiac-strip{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));list-style:none;margin:0 0 .9rem;padding:0;border:1px solid var(--line-dark);background:var(--paper-pale)}.zodiac-strip li{min-width:0;border-right:1px solid var(--line)}.zodiac-strip li:last-child{border-right:0}
  .zodiac-strip a{display:grid;grid-template-rows:1.6rem auto;place-items:center;min-height:3.7rem;padding:.42rem .12rem;text-decoration:none;color:var(--ink);text-align:center}.zodiac-strip a:hover{background:var(--paper-deep);color:var(--accent)}.zodiac-strip .current{background:var(--paper-deep);box-shadow:inset 0 -3px 0 var(--ink)}
  .strip-glyph{font-size:1.28rem;line-height:1}.strip-name{font:700 .51rem/1.15 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;text-transform:uppercase;letter-spacing:.025em;overflow:hidden;text-overflow:ellipsis;max-width:100%}
  .profile-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--line-dark);border-left:1px solid var(--line-dark);background:var(--paper-pale)}
  .profile-grid>div{min-height:6rem;padding:.65rem .7rem;border-right:1px solid var(--line-dark);border-bottom:1px solid var(--line-dark);display:flex;flex-direction:column;justify-content:space-between;gap:.5rem}.profile-grid span{font:700 .58rem/1.3 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}.profile-grid strong{font-size:.84rem;line-height:1.35;font-weight:600}.profile-grid a{text-decoration:none;border-bottom:1px dotted currentColor}.profile-grid a:hover{border-bottom-style:solid}
  .profile-notes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.2rem;margin-top:.85rem;max-width:72rem;color:var(--muted)}.profile-notes p{margin:0;font-size:.82rem}.profile-notes strong{color:var(--ink)}
  @media(max-width:980px){.zodiac-strip{grid-template-columns:repeat(6,minmax(0,1fr))}.zodiac-strip li:nth-child(6){border-right:0}.zodiac-strip li:nth-child(-n+6){border-bottom:1px solid var(--line)}.profile-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.profile-notes{grid-template-columns:1fr}}
  @media(max-width:720px){.profile-head{display:block}.source-link{display:inline-block;text-align:left;margin-top:.55rem}.profile-grid{grid-template-columns:1fr}.profile-grid>div{min-height:0}.zodiac-strip{grid-template-columns:repeat(4,minmax(0,1fr))}.zodiac-strip li{border-bottom:1px solid var(--line)}.zodiac-strip li:nth-child(4n){border-right:0}.zodiac-strip li:nth-last-child(-n+4){border-bottom:0}.strip-name{display:none}.zodiac-strip a{min-height:2.8rem;grid-template-rows:1fr}}
</style>

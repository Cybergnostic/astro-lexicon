---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LexiconDirectory from '../../components/LexiconDirectory.astro';
import corpus from '../../data/generated/corpus.json';

const { terms, authors, works } = corpus;
---
<BaseLayout title="A–Z Dictionary — Astrological Lexicon" description="Search and browse every traditional astrological headword, definition and historical alias.">
  <header class="collection-header">
    <div class="shell">
      <p class="collection-eyebrow"><a href="/">HOME</a> <span aria-hidden="true">/</span> DICTIONARY</p>
      <h1>Dictionary A–Z</h1>
      <p>Headwords, definitions, historical names and technical terms in one searchable index.</p>
    </div>
  </header>
  <LexiconDirectory terms={terms} authors={authors} works={works} />
</BaseLayout>

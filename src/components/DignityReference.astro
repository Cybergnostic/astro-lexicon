---
const { schemes = [] } = Astro.props;

const signOrder = [
  ['aries','Aries','♈'],['taurus','Taurus','♉'],['gemini','Gemini','♊'],['cancer','Cancer','♋'],
  ['leo','Leo','♌'],['virgo','Virgo','♍'],['libra','Libra','♎'],['scorpio','Scorpio','♏'],
  ['sagittarius','Sagittarius','♐'],['capricorn','Capricorn','♑'],['aquarius','Aquarius','♒'],['pisces','Pisces','♓']
];

const planetGlyphs = {
  sun:'☉', moon:'☽', mercury:'☿', venus:'♀', mars:'♂', jupiter:'♃', saturn:'♄'
};

const assignmentsFor = (scheme, signSlug, type) => scheme.assignments
  .filter((item) => item.sign_slug === signSlug && item.assignment_type === type)
  .sort((a,b) => (a.sequence_no ?? 0) - (b.sequence_no ?? 0) || a.degree_start - b.degree_start);

const wholeSign = (scheme, signSlug, type) => assignmentsFor(scheme, signSlug, type)[0];
const glyphFor = (item) => item ? (planetGlyphs[item.planet_slug] ?? '•') : '—';
const exactDegree = (item) => item?.exact_degree_number ? `${item.exact_degree_number}°` : '';
const endDegree = (item) => item ? Number(item.degree_end) : '';
const spanLength = (item) => item ? Number(item.degree_end) - Number(item.degree_start) : '';
const rangeLabel = (item) => `${Number(item.degree_start)}–${Number(item.degree_end)}°`;
const hasNonTermData = (scheme) => scheme.assignments.some((item) => item.assignment_type !== 'term');
const fullSchemes = schemes.filter(hasNonTermData);
const termSchemes = schemes.filter((scheme) => scheme.assignments.some((item) => item.assignment_type === 'term'));
---

{fullSchemes.map((scheme) => (
  <section class="reference-system" id={`reference-${scheme.slug}`}>
    <div class="reference-head">
      <div>
        <p class="micro-label">Normalized reference system</p>
        <h2>{scheme.label}</h2>
      </div>
      {scheme.author_name && <p class="reference-source">{scheme.author_name}{scheme.work_title ? ` · ${scheme.work_title}` : ''}</p>}
    </div>
    {scheme.notes && <p class="reference-note">{scheme.notes}</p>}

    <div class="matrix-wrap" tabindex="0" aria-label={`${scheme.label} rulership table`}>
      <table class="dignity-matrix">
        <thead>
          <tr class="group-head">
            <th scope="col" rowspan="2" class="sign-head">Sign</th>
            <th scope="col" rowspan="2">Domicile</th>
            <th scope="col" rowspan="2">Exaltation</th>
            <th scope="colgroup" colspan="3">Triplicity lords</th>
            <th scope="colgroup" colspan="5">Terms / bounds</th>
            <th scope="colgroup" colspan="3">Faces / decans</th>
            <th scope="col" rowspan="2">Detriment</th>
            <th scope="col" rowspan="2">Fall</th>
          </tr>
          <tr class="sub-head">
            <th scope="col">Day</th>
            <th scope="col">Night</th>
            <th scope="col">Both</th>
            <th scope="col">1</th><th scope="col">2</th><th scope="col">3</th><th scope="col">4</th><th scope="col">5</th>
            <th scope="col">1</th><th scope="col">2</th><th scope="col">3</th>
          </tr>
        </thead>
        <tbody>
          {signOrder.map(([slug,label,signGlyph]) => {
            const domicile = wholeSign(scheme, slug, 'domicile');
            const exaltation = wholeSign(scheme, slug, 'exaltation');
            const detriment = wholeSign(scheme, slug, 'detriment');
            const fall = wholeSign(scheme, slug, 'fall');
            const triplicity = assignmentsFor(scheme, slug, 'triplicity');
            const dayTrip = triplicity.find((item) => item.sect_condition === 'day');
            const nightTrip = triplicity.find((item) => item.sect_condition === 'night');
            const bothTrip = triplicity.find((item) => item.sect_condition === 'any');
            const terms = assignmentsFor(scheme, slug, 'term');
            const faces = assignmentsFor(scheme, slug, 'face');
            return (
              <tr>
                <th scope="row" class="sign-cell">
                  <a href={`/terms/${slug}/`}>
                    <span class="sign-glyph" aria-hidden="true">{signGlyph}</span>
                    <span>{label}</span>
                  </a>
                </th>

                <td class="planet-cell">
                  {domicile ? <a href={`/terms/${domicile.planet_slug}/`} title={domicile.planet_label}><span aria-hidden="true">{glyphFor(domicile)}</span><span class="sr-only">{domicile.planet_label}</span></a> : '—'}
                </td>
                <td class="planet-cell exact-cell">
                  {exaltation ? <a href={`/terms/${exaltation.planet_slug}/`} title={`${exaltation.planet_label}${exactDegree(exaltation) ? ` · ${exactDegree(exaltation)}` : ''}`}><span aria-hidden="true">{glyphFor(exaltation)}</span><span class="sr-only">{exaltation.planet_label}</span>{exactDegree(exaltation) && <small>{exactDegree(exaltation)}</small>}</a> : '—'}
                </td>

                {[dayTrip,nightTrip,bothTrip].map((item) => <td class="planet-cell trip-cell">
                  {item ? <a href={`/terms/${item.planet_slug}/`} title={item.planet_label}><span aria-hidden="true">{glyphFor(item)}</span><span class="sr-only">{item.planet_label}</span></a> : <span class="empty">—</span>}
                </td>)}

                {[0,1,2,3,4].map((index) => {
                  const item = terms[index];
                  return <td class="bound-cell">
                    {item ? <a href={`/terms/${item.planet_slug}/`} title={`${item.planet_label} · ${rangeLabel(item)}`}>
                      <span class="planet-glyph" aria-hidden="true">{glyphFor(item)}</span>
                      <span class="sr-only">{item.planet_label}</span>
                      <small>{endDegree(item)} <span>({spanLength(item)})</span></small>
                    </a> : <span class="empty">—</span>}
                  </td>;
                })}

                {[0,1,2].map((index) => {
                  const item = faces[index];
                  return <td class="planet-cell face-cell">
                    {item ? <a href={`/terms/${item.planet_slug}/`} title={`${item.planet_label} · ${rangeLabel(item)}`}><span aria-hidden="true">{glyphFor(item)}</span><span class="sr-only">{item.planet_label}</span></a> : <span class="empty">—</span>}
                  </td>;
                })}

                <td class="planet-cell">
                  {detriment ? <a href={`/terms/${detriment.planet_slug}/`} title={detriment.planet_label}><span aria-hidden="true">{glyphFor(detriment)}</span><span class="sr-only">{detriment.planet_label}</span></a> : '—'}
                </td>
                <td class="planet-cell exact-cell">
                  {fall ? <a href={`/terms/${fall.planet_slug}/`} title={`${fall.planet_label}${exactDegree(fall) ? ` · ${exactDegree(fall)}` : ''}`}><span aria-hidden="true">{glyphFor(fall)}</span><span class="sr-only">{fall.planet_label}</span>{exactDegree(fall) && <small>{exactDegree(fall)}</small>}</a> : '—'}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <div class="matrix-key">
      <span><strong>Terms:</strong> boundary degree <em>(span)</em></span>
      <span><strong>Both:</strong> same triplicity ruler by day and night</span>
      <span>Exact exaltation / fall degrees appear beneath the glyph.</span>
    </div>
  </section>
))}

{termSchemes.length > 1 && (
  <section class="reference-system terms-comparison" id="reference-terms-comparison">
    <div class="reference-head">
      <div>
        <p class="micro-label">Historical scheme comparison</p>
        <h2>Terms / bounds by named scheme</h2>
      </div>
    </div>
    <p class="reference-note">The term or bound ruler is not universal across the tradition. Each column below preserves a separate historical table, so the same zodiacal degree can be compared without silently merging the schemes.</p>
    <div class="scheme-notes">
      {termSchemes.map((scheme) => <div>
        <strong>{scheme.label}</strong>
        {scheme.notes && <span>{scheme.notes}</span>}
      </div>)}
    </div>
    <div class="table-scroll" tabindex="0">
      <table class="terms-table">
        <thead>
          <tr>
            <th scope="col">Sign</th>
            {termSchemes.map((scheme) => <th scope="col">{scheme.label}</th>)}
          </tr>
        </thead>
        <tbody>
          {signOrder.map(([slug,label,glyph]) => (
            <tr>
              <th scope="row"><a href={`/terms/${slug}/`}><span class="sign-glyph">{glyph}</span>{label}</a></th>
              {termSchemes.map((scheme) => <td class="term-strip">
                {assignmentsFor(scheme, slug, 'term').map((item) => <a href={`/terms/${item.planet_slug}/`} title={`${item.planet_label} · ${rangeLabel(item)}`}>
                  <span class="planet-glyph" aria-hidden="true">{glyphFor(item)}</span>
                  <span class="sr-only">{item.planet_label}</span>
                  <small>{endDegree(item)}°</small>
                </a>)}
              </td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="reference-footnote">Each compact sequence reads from 0° to 30°. The number beneath a planetary glyph is the degree at which rulership transfers to the next term.</p>
  </section>
)}

<style>
  .reference-system{margin:3rem 0}
  .reference-head{display:flex;gap:1.5rem;align-items:flex-end;justify-content:space-between;border-bottom:1px solid var(--line-dark);padding-bottom:.8rem;margin-bottom:.8rem}
  .reference-head h2{margin:.15rem 0 0}
  .reference-source,.reference-note,.reference-footnote{color:var(--muted)}
  .reference-source{font-size:.82rem;text-align:right;max-width:24rem}
  .reference-note{max-width:58rem;margin:.5rem 0 1rem}
  .reference-footnote{font-size:.82rem;max-width:58rem;margin:.8rem 0 0}
  .scheme-notes{display:grid;grid-template-columns:repeat(auto-fit,minmax(18rem,1fr));gap:.7rem;margin:0 0 1rem}
  .scheme-notes>div{border-left:3px solid var(--line-dark);padding:.55rem .7rem;background:var(--paper-pale)}
  .scheme-notes strong,.scheme-notes span{display:block}
  .scheme-notes span{margin-top:.25rem;color:var(--muted);font-size:.82rem}

  .matrix-wrap{border:2px solid var(--ink);background:var(--paper-pale);overflow:hidden}
  .dignity-matrix{width:100%;border-collapse:collapse;table-layout:fixed;font-size:.76rem;line-height:1.18}
  .dignity-matrix th,.dignity-matrix td{height:3.45rem;padding:.28rem .18rem;text-align:center;vertical-align:middle;border-right:1px solid var(--line-dark);border-bottom:1px solid var(--line-dark)}
  .dignity-matrix tr>*:last-child{border-right:0}.dignity-matrix tbody tr:last-child>*{border-bottom:0}
  .dignity-matrix thead th{font:700 .57rem/1.18 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;text-transform:uppercase;letter-spacing:.035em;background:var(--paper-deep)}
  .dignity-matrix .group-head th{border-bottom:1px solid var(--ink)}
  .dignity-matrix .sub-head th{height:1.65rem;padding:.18rem .08rem;font-size:.53rem}
  .dignity-matrix .sign-head{width:8.2rem}
  .sign-cell{background:var(--paper-deep);text-align:left!important;padding-left:.48rem!important}
  .sign-cell a{display:flex;align-items:center;gap:.42rem;color:var(--ink);text-decoration:none}.sign-cell a:hover{color:var(--accent)}
  .sign-cell .sign-glyph{font-size:1.42rem;line-height:1}.sign-cell span:last-child{font-size:.72rem;text-transform:uppercase;letter-spacing:.035em}
  .planet-cell>a,.bound-cell>a{display:flex;min-height:2.5rem;align-items:center;justify-content:center;color:var(--ink);text-decoration:none}
  .planet-cell>a{flex-direction:column}.planet-cell>a>span:first-child,.bound-cell .planet-glyph{font-family:"Noto Sans Symbols 2","Segoe UI Symbol","DejaVu Sans",sans-serif;font-size:1.35rem;line-height:1}
  .planet-cell>a:hover,.bound-cell>a:hover{color:var(--accent);background:color-mix(in srgb,var(--paper-deep) 55%,transparent)}
  .exact-cell small{display:block;margin-top:.15rem;font:.53rem/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:var(--muted)}
  .trip-cell{width:3rem}.bound-cell{padding:.18rem .05rem!important}.bound-cell>a{flex-direction:column;gap:.14rem}
  .bound-cell small{font:700 .49rem/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:var(--ink);white-space:nowrap}.bound-cell small span{color:var(--muted);font-weight:500}
  .face-cell{width:2.8rem}.empty{color:var(--line-dark)}
  .matrix-key{display:flex;flex-wrap:wrap;gap:.35rem 1.25rem;margin-top:.55rem;color:var(--muted);font:.64rem/1.45 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}.matrix-key strong{color:var(--ink)}.matrix-key em{font-style:normal}
  .matrix-wrap:focus-visible,.table-scroll:focus-visible{outline:2px solid var(--accent);outline-offset:3px}

  .table-scroll{overflow-x:auto;border:1px solid var(--line-dark);background:var(--paper-pale)}
  .terms-table{border-collapse:collapse;width:100%;font-size:.82rem}
  .terms-table th,.terms-table td{padding:.55rem .65rem;text-align:left;vertical-align:middle;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
  .terms-table th:last-child,.terms-table td:last-child{border-right:0}.terms-table tbody tr:last-child th,.terms-table tbody tr:last-child td{border-bottom:0}
  .terms-table thead th{font:700 .62rem/1.3 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;text-transform:uppercase;letter-spacing:.05em;background:var(--paper-deep)}
  .terms-table tbody th{background:var(--paper-deep);white-space:nowrap}.terms-table tbody th a{color:var(--ink);text-decoration:none}
  .term-strip{display:grid;grid-template-columns:repeat(5,minmax(2.5rem,1fr));padding:0!important}
  .term-strip>a{display:flex;min-height:3.2rem;flex-direction:column;align-items:center;justify-content:center;gap:.12rem;color:var(--ink);text-decoration:none;border-right:1px solid var(--line)}.term-strip>a:last-child{border-right:0}.term-strip>a:hover{background:var(--paper-deep);color:var(--accent)}
  .term-strip .planet-glyph{font-size:1.2rem}.term-strip small{font:.55rem ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:var(--muted)}
  .sign-glyph{font-size:1.15rem;margin-right:.4rem;vertical-align:-.05em}
  .sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}

  @media(max-width:980px){
    .matrix-wrap{overflow-x:auto}
    .dignity-matrix{min-width:64rem}
  }
  @media(max-width:720px){
    .reference-head{display:block}.reference-source{text-align:left;margin-top:.5rem}.scheme-notes{grid-template-columns:1fr}
    .matrix-key{display:grid;grid-template-columns:1fr}.terms-table{min-width:48rem}
  }
</style>

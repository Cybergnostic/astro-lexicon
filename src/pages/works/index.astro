---
import BaseLayout from '../../layouts/BaseLayout.astro';
import corpus from '../../data/generated/corpus.json';

const { works } = corpus;

const groups = [];
for (const work of works) {
  let group = groups.find((item) => item.author_slug === work.author_slug);
  if (!group) {
    group = {
      author_slug: work.author_slug,
      author_name: work.author_name,
      historical_layer: work.historical_layer,
      works: [],
    };
    groups.push(group);
  }
  group.works.push(work);
}

const statusLabel = {
  indexed: 'Indexed',
  partial: 'Partially indexed',
  bibliographic: 'Bibliographic only',
};

const coverageText = (work) => {
  if (work.corpus_status === 'bibliographic') {
    return 'Bibliographic reference · not yet indexed for lexicon evidence.';
  }
  if (work.corpus_status === 'partial') {
    return `Partially indexed · ${work.interpretation_count} reviewed source accounts so far.`;
  }
  return `${work.interpretation_count} reviewed source accounts in the current lexicon.`;
};
---
<BaseLayout title="Works — Astrological Lexicon">
  <header class="page-header">
    <div class="shell">
      <p class="hero-kicker">Bibliography · source corpus</p>
      <h1>Works</h1>
      <p class="page-deck">The literature layer records works and editions even when a book has not yet been fully indexed. Coverage status distinguishes bibliography from partial and completed source extraction.</p>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      {groups.map((group) =>
        <section class="literature-group">
          <p class="micro-label">{group.historical_layer}</p>
          <h2>{group.author_name}</h2>
          {group.works.map((work) =>
            <div class="work-row">
              <div>
                <a href={`/works/${work.slug}/`}><strong><em>{work.title}</em></strong></a>
                {work.original_title && <p>{work.original_title}</p>}
                <p>{coverageText(work)}</p>
              </div>
              <div>
                <span class="count">{statusLabel[work.corpus_status] || work.corpus_status}</span>
                <p>{work.language || 'source work'}</p>
              </div>
            </div>
          )}
        </section>
      )}
    </div>
  </section>
</BaseLayout>

---
import '../styles/global.css';
import '../styles/reference-overrides.css';
import '../styles/lexicon-redesign.css';

const {
  title = 'Astrological Lexicon',
  description = 'A scholarly reference to the historical language of astrology.'
} = Astro.props;
const basePath = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#142a37" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400..700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="wordmark" href="/" aria-label="Astrological Lexicon, home">
          <span class="wordmark-seal" aria-hidden="true">AL</span>
          <span class="wordmark-type"><strong>ASTROLOGICAL</strong><span>LEXICON</span></span>
        </a>
        <nav class="nav" aria-label="Main navigation">
          <a href="/terms/">Dictionary A–Z</a>
          <a href="/#subjects">Subjects</a>
          <a href="/authors/">Authors</a>
          <a href="/works/">Source works</a>
        </nav>
      </div>
    </header>

    <main id="main-content"><slot /></main>

    <footer class="footer">
      <div class="shell footer-grid">
        <div class="footer-identity">
          <strong>Astrological Lexicon</strong>
          <p>A historical reference for traditional astrological terminology.</p>
        </div>
        <div class="footer-links">
          <a href="/terms/">Dictionary</a>
          <a href="/authors/">Historical authors</a>
          <a href="/works/">Source works</a>
        </div>
        <div class="footer-note">
          <p>Ancient and medieval concepts, distinguished by language, author and historical source.</p>
        </div>
      </div>
    </footer>

    <script define:vars={{ basePath }} is:inline>
      if (basePath) {
        const prefixInternalLink = (link) => {
          const href = link.getAttribute('href');
          if (!href || !href.startsWith('/') || href.startsWith('//') || href === basePath || href.startsWith(basePath + '/')) return;
          link.setAttribute('href', basePath + href);
        };
        const rewriteInternalLinks = (root) => {
          if (root instanceof HTMLAnchorElement) prefixInternalLink(root);
          root.querySelectorAll?.('a[href^="/"]').forEach(prefixInternalLink);
        };
        rewriteInternalLinks(document);
        new MutationObserver((mutations) => {
          for (const mutation of mutations) {
            for (const node of mutation.addedNodes) {
              if (node instanceof Element) rewriteInternalLinks(node);
            }
          }
        }).observe(document.body, { childList: true, subtree: true });
      }
    </script>
  </body>
</html>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { terms, authors } from '../data/preview';

const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const availableLetters = new Set(terms.map((term) => term.label.charAt(0).toUpperCase()));
---
<BaseLayout>
  <div class="shell page-grid">
    <article class="article">
      <p class="eyebrow">Source-based reference work</p>
      <h1>Astrological<br />Lexicon</h1>
      <p class="lede">A source-based encyclopedia of traditional astrological terminology, built from historical texts rather than flattened modern definitions.</p>

      <div class="search">
        <input id="term-search" type="search" autocomplete="off" placeholder="Search terms, authors, works…" aria-label="Search lexicon" />
        <div id="search-results" class="search-results"></div>
      </div>

      <p class="eyebrow">Browse</p>
      <div class="alpha" aria-label="Alphabetical index">
        <a href="#terms" data-letter="ALL" class="alpha-all">All</a>
        {alphabet.map((letter) => (
          availableLetters.has(letter)
            ? <a href={`#${letter}`} data-letter={letter}>{letter}</a>
            : <span class="is-empty" aria-disabled="true">{letter}</span>
        ))}
      </div>

      <section id="terms">
        <h2 id="terms-heading">Current terms</h2>
        <p id="no-letter-results" class="meta browse-empty" hidden>No terms under this letter yet.</p>
        <ul id="term-list" class="list-clean">
          {terms.map((term) => (
            <li data-term-letter={term.label.charAt(0).toUpperCase()}>
              <a href={`/terms/${term.slug}`}>{term.label}</a>
              <span class="count">{term.category}</span>
            </li>
          ))}
        </ul>
      </section>

      <section id="sources">
        <h2>Sources in the initial corpus</h2>
        <ul class="list-clean">
          {authors.map((author) => (
            <li>
              <span>{author.name} — <em>{author.work}</em></span>
              <span class="count">{author.layer}</span>
            </li>
          ))}
        </ul>
      </section>

      <section id="method">
        <h2>Method</h2>
        <p>Entries distinguish source evidence from editorial synthesis. Historical variants are preserved rather than silently merged. Short quotations may be used where necessary, while the public text is primarily paraphrase, bibliography, and source location.</p>
      </section>
    </article>

    <aside class="toc">
      <strong>Index</strong>
      <a href="#terms">Current terms</a>
      <a href="#sources">Sources</a>
      <a href="#method">Method</a>
    </aside>
  </div>

  <script define:vars={{ terms, authors }} is:inline>
    const input = document.getElementById('term-search');
    const box = document.getElementById('search-results');
    const index = [
      ...terms.map((x) => ({ label: x.label, kind: 'term', detail: x.category, href: `/terms/${x.slug}` })),
      ...authors.map((x) => ({ label: x.name, kind: 'author', detail: x.work, href: x.name === 'Guido Bonatti' ? '/authors/guido-bonatti' : '#sources' }))
    ];

    input?.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      if (!q) {
        box.classList.remove('is-open');
        box.innerHTML = '';
        return;
      }
      const results = index.filter((x) => `${x.label} ${x.detail}`.toLowerCase().includes(q)).slice(0, 8);
      box.innerHTML = results.length
        ? results.map((x) => `<a class="search-result" href="${x.href}"><small>${x.kind}</small><span><strong>${x.label}</strong><br><span class="meta">${x.detail}</span></span></a>`).join('')
        : `<div class="search-result"><small>search</small><span>No indexed result yet.</span></div>`;
      box.classList.add('is-open');
    });

    const alphaLinks = Array.from(document.querySelectorAll('.alpha a[data-letter]'));
    const termRows = Array.from(document.querySelectorAll('#term-list li[data-term-letter]'));
    const termsHeading = document.getElementById('terms-heading');
    const emptyMessage = document.getElementById('no-letter-results');

    function applyLetterFilter(letter, { updateHash = false } = {}) {
      const normalized = letter === 'ALL' ? 'ALL' : String(letter || '').toUpperCase();
      const filter = /^[A-Z]$/.test(normalized) ? normalized : 'ALL';
      let visibleCount = 0;

      termRows.forEach((row) => {
        const visible = filter === 'ALL' || row.dataset.termLetter === filter;
        row.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      alphaLinks.forEach((link) => {
        link.classList.toggle('active', link.dataset.letter === filter);
        if (link.dataset.letter === filter) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });

      if (termsHeading) termsHeading.textContent = filter === 'ALL' ? 'Current terms' : `Current terms — ${filter}`;
      if (emptyMessage) emptyMessage.hidden = visibleCount !== 0;

      if (updateHash) {
        const nextHash = filter === 'ALL' ? '#terms' : `#${filter}`;
        history.replaceState(null, '', nextHash);
      }
    }

    alphaLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        applyLetterFilter(link.dataset.letter, { updateHash: true });
        document.getElementById('terms')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    function filterFromHash() {
      const hash = window.location.hash.replace('#', '').toUpperCase();
      if (/^[A-Z]$/.test(hash)) applyLetterFilter(hash);
      else if (hash === 'TERMS' || !hash) applyLetterFilter('ALL');
    }

    window.addEventListener('hashchange', filterFromHash);
    filterFromHash();
  </script>
</BaseLayout>

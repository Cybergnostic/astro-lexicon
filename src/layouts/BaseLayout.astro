---
import '../styles/global.css';
import '../styles/reference-overrides.css';
import '../styles/lexicon-redesign.css';
const {
  title = 'Astrological Lexicon',
  description = 'A source-based encyclopedia of traditional astrological terminology.'
} = Astro.props;
const basePath = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#efe9dc" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400..700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <div class="top-rule" aria-hidden="true"></div>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="wordmark" href="/" aria-label="Astrological Lexicon home">
          <span class="wordmark-mark">✶</span>
          <span>Astrological Lexicon</span>
        </a>
        <nav class="nav" aria-label="Primary">
          <a href="/terms/">A–Z Index</a>
          <a href="/authors/">Authors</a>
          <a href="/works/">Works</a>
          <a href="/#subjects">Subjects</a>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="footer">
      <div class="shell footer-grid">
        <div>
          <strong>Astrological Lexicon</strong>
          <p>A historical reference work for traditional astrological terminology.</p>
        </div>
        <div>
          <span class="micro-label">Sources represented</span>
          <p>Antiochus · Abū Maʿshar · al-Bīrūnī · Bonatti · Lilly · additional source witnesses</p>
        </div>
        <div class="footer-status">
          <span class="micro-label">Approach</span>
          <p>Definitions, historical variants and reference systems remain source-attributed.</p>
        </div>
      </div>
    </footer>

    <script define:vars={{ basePath }} is:inline>
      if (basePath) {
        const prefixInternalLink = (link) => {
          const href = link.getAttribute('href');
          if (!href || !href.startsWith('/') || href.startsWith('//') || href === basePath || href.startsWith(`${basePath}/`)) return;
          link.setAttribute('href', `${basePath}${href}`);
        };

        const rewriteInternalLinks = (root) => {
          if (root instanceof HTMLAnchorElement) prefixInternalLink(root);
          root.querySelectorAll?.('a[href^="/"]').forEach(prefixInternalLink);
        };

        rewriteInternalLinks(document);
        new MutationObserver((mutations) => {
          for (const mutation of mutations) {
            for (const node of mutation.addedNodes) {
              if (node instanceof Element) rewriteInternalLinks(node);
            }
          }
        }).observe(document.body, { childList: true, subtree: true });
      }
    </script>
  </body>
</html>
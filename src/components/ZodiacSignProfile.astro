---
const { profile } = Astro.props;
const signs = [['aries','Aries','♈'],['taurus','Taurus','♉'],['gemini','Gemini','♊'],['cancer','Cancer','♋'],['leo','Leo','♌'],['virgo','Virgo','♍'],['libra','Libra','♎'],['scorpio','Scorpio','♏'],['sagittarius','Sagittarius','♐'],['capricorn','Capricorn','♑'],['aquarius','Aquarius','♒'],['pisces','Pisces','♓']];
const quarterLabel = (value) => ({'march-equinox':'March-equinox quarter','june-solstice':'June-solstice quarter','september-equinox':'September-equinox quarter','december-solstice':'December-solstice quarter'}[value] ?? value);
const positionLabel = (value) => ({ beginning:'Beginning', middle:'Middle', closing:'Closing' }[value] ?? value);
const degreeLabel = (value) => Number(value).toLocaleString('en-US', { maximumFractionDigits: 2 });
---

{profile && <section class="sign-profile" id="sign-profile">
  <div class="profile-head">
    <div>
      <p class="micro-label">Traditional reference</p>
      <h2>Zodiac sign profile</h2>
    </div>
  </div>

  <ol class="zodiac-strip" aria-label="Twelve equal signs of the tropical zodiac">
    {signs.map(([slug,label,glyph], index) => <li class:list={{ current: index + 1 === profile.ordinal }} aria-current={index + 1 === profile.ordinal ? 'true' : undefined}><a href={`/terms/${slug}/`} title={`${label}: ${index * 30}°–${(index + 1) * 30}°`}><span class="strip-glyph" aria-hidden="true">{glyph}</span><span class="strip-name">{label}</span></a></li>)}
  </ol>

  <p class="group-label">Traditional classification</p>
  <div class="profile-grid primary-grid">
    <div><span>Element / triplicity</span><strong><a href={`/terms/${profile.element_slug}/`}>{profile.element_label}</a></strong></div>
    <div><span>Modality</span><strong><a href={`/terms/${profile.modality_slug}/`}>{profile.modality_label}</a></strong></div>
    <div><span>Polarity / sex</span><strong><a href={`/terms/${profile.polarity_slug}/`}>{profile.polarity_label}</a></strong></div>
    <div><span>Day / night class</span><strong><a href={`/terms/${profile.day_night_slug}/`}>{profile.day_night_label}</a></strong></div>
  </div>

  {profile.tradition_note && <p class="tradition-note"><strong>Classification note.</strong> {profile.tradition_note}</p>}

  <p class="group-label technical-label">Zodiac position & geometry</p>
  <div class="profile-grid secondary-grid">
    <div><span>Position</span><strong>Sign {profile.ordinal} of 12</strong></div>
    <div><span>Tropical quarter</span><strong>{quarterLabel(profile.quarter_anchor)} · {positionLabel(profile.quarter_position)}</strong></div>
    <div><span>Tropical longitude</span><strong>{degreeLabel(profile.longitude_start)}°–{degreeLabel(profile.longitude_end)}°</strong></div>
    <div><span>Solar annual half</span><strong>Sun {profile.solar_declination_half} of the celestial equator between the boundary points</strong></div>
  </div>

  <div class="geometry-notes">
    {profile.geometry_note && <p><strong>Geometry.</strong> {profile.geometry_note}</p>}
    {profile.astronomy_source_label && profile.astronomy_source_url && <p class="astronomy-source"><strong>Astronomy reference.</strong> <a href={profile.astronomy_source_url} rel="noreferrer">{profile.astronomy_source_label}</a></p>}
  </div>
</section>}

<style>
  .sign-profile{margin:3rem 0}.profile-head{display:flex;gap:1.5rem;align-items:flex-end;justify-content:space-between;border-top:1px solid var(--line-dark);border-bottom:1px solid var(--line);padding:.8rem 0;margin-bottom:1rem}.profile-head h2{margin:0;border:0;padding:0}.profile-head .micro-label{margin:0 0 .2rem}.zodiac-strip{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));list-style:none;margin:0 0 1.15rem;padding:0;border:1px solid var(--line-dark);background:var(--paper-pale)}.zodiac-strip li{min-width:0;border-right:1px solid var(--line)}.zodiac-strip li:last-child{border-right:0}.zodiac-strip a{display:grid;grid-template-rows:1.6rem auto;place-items:center;min-height:3.7rem;padding:.42rem .12rem;text-decoration:none;color:var(--ink);text-align:center}.zodiac-strip a:hover{background:var(--paper-deep);color:var(--accent)}.zodiac-strip .current{background:var(--paper-deep);box-shadow:inset 0 -3px 0 var(--ink)}.strip-glyph{font-size:1.28rem;line-height:1}.strip-name{font:700 .51rem/1.15 var(--font-ui,ui-sans-serif,system-ui,sans-serif);text-transform:uppercase;letter-spacing:.025em;overflow:hidden;text-overflow:ellipsis;max-width:100%}.group-label{margin:0 0 .42rem;font:700 .61rem/1.3 var(--font-ui,ui-sans-serif,system-ui,sans-serif);text-transform:uppercase;letter-spacing:.07em;color:var(--muted)}.technical-label{margin-top:1.25rem}.profile-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--line-dark);border-left:1px solid var(--line-dark);background:var(--paper-pale)}.profile-grid>div{min-height:5.4rem;padding:.65rem .7rem;border-right:1px solid var(--line-dark);border-bottom:1px solid var(--line-dark);display:flex;flex-direction:column;justify-content:space-between;gap:.5rem}.primary-grid{background:var(--paper-deep)}.profile-grid span{font:700 .58rem/1.3 var(--font-ui,ui-sans-serif,system-ui,sans-serif);text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}.profile-grid strong{font-size:.88rem;line-height:1.35;font-weight:650}.profile-grid a{text-decoration:none;border-bottom:1px dotted currentColor}.profile-grid a:hover{border-bottom-style:solid}.tradition-note,.geometry-notes{max-width:72rem;color:var(--muted);font-size:.82rem}.tradition-note{margin:.8rem 0 0}.tradition-note strong,.geometry-notes strong{color:var(--ink)}.geometry-notes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem;margin-top:.8rem}.geometry-notes p{margin:0}.astronomy-source a{color:inherit;text-decoration:none;border-bottom:1px dotted currentColor}.astronomy-source a:hover{border-bottom-style:solid}@media(max-width:980px){.zodiac-strip{grid-template-columns:repeat(6,minmax(0,1fr))}.zodiac-strip li:nth-child(6){border-right:0}.zodiac-strip li:nth-child(-n+6){border-bottom:1px solid var(--line)}.profile-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.geometry-notes{grid-template-columns:1fr}}@media(max-width:720px){.profile-grid{grid-template-columns:1fr}.profile-grid>div{min-height:0}.zodiac-strip{grid-template-columns:repeat(4,minmax(0,1fr))}.zodiac-strip li{border-bottom:1px solid var(--line)}.zodiac-strip li:nth-child(4n){border-right:0}.zodiac-strip li:nth-last-child(-n+4){border-bottom:0}.strip-name{display:none}.zodiac-strip a{min-height:2.8rem;grid-template-rows:1fr}}
</style>
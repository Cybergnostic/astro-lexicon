---
import { browseSubjects, subjectSlugsForTerm } from '../data/browseSubjects.js';

const { terms = [], authors = [], works = [] } = Astro.props;
const orderedTerms = [...terms].sort((a, b) => a.label.localeCompare(b.label, 'en', { sensitivity: 'base' }));
const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const subjectCounts = Object.fromEntries(
  browseSubjects.map((subject) => [subject.slug, orderedTerms.filter((term) => subjectSlugsForTerm(term).includes(subject.slug)).length])
);
const availableLetters = new Set(orderedTerms.map((term) => term.label.charAt(0).toUpperCase()));
const authorList = [...authors].sort((a,b) => a.name.localeCompare(b.name)).slice(0, 7);
const workList = [...works].sort((a,b) => a.title.localeCompare(b.title)).slice(0, 4);
---
<section class="dictionary-shell shell" data-directory aria-labelledby="dictionary-heading">
  <div class="dictionary-intro">
    <div>
      <p class="directory-kicker">THE REFERENCE INDEX</p>
      <h2 id="dictionary-heading">Explore the dictionary<span class="directory-period">.</span></h2>
      <p>Search a headword, find an older name, or explore a branch of traditional doctrine.</p>
    </div>
    <span class="directory-count">{orderedTerms.length} HEADWORDS</span>
  </div>

  <div class="directory-tools">
    <div class="directory-search-wrap">
      <label for="directory-search">SEARCH THE LEXICON</label>
      <div class="directory-search-field">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.4 15.4 5.1 5.1"/></svg>
        <input id="directory-search" type="search" placeholder="Try reception, profections, al-mubtazz…" autocomplete="off" data-directory-search />
        <kbd>/</kbd>
      </div>
    </div>
    <nav class="directory-alphabet" aria-label="Alphabetical entry filter">
      <button type="button" class="directory-letter directory-letter-all" data-directory-letter="ALL" aria-pressed="true">All</button>
      {letters.map((letter) => (
        <button type="button" class="directory-letter" data-directory-letter={letter} aria-pressed="false" disabled={!availableLetters.has(letter)}>{letter}</button>
      ))}
    </nav>
  </div>

  <div class="dictionary-layout">
    <aside class="directory-facets" id="subjects" aria-label="Subjects">
      <div class="directory-facet-heading">
        <h3>Subjects</h3>
        <button type="button" class="directory-facet-toggle" data-topic-toggle aria-expanded="false" aria-controls="directory-subjects">Choose a subject <span aria-hidden="true">⌄</span></button>
      </div>
      <div class="directory-subject-list" id="directory-subjects">
        <button type="button" data-directory-subject="ALL" aria-pressed="true">
          <span>All subjects</span><small>{orderedTerms.length}</small>
        </button>
        {browseSubjects.map((subject) => (
          <button type="button" data-directory-subject={subject.slug} aria-pressed="false" title={subject.detail}>
            <span>{subject.name}</span><small>{subjectCounts[subject.slug]}</small>
          </button>
        ))}
      </div>
      <p class="directory-facet-note">Categories overlap where a concept belongs to several branches.</p>
    </aside>

    <div class="directory-results">
      <div class="directory-results-head">
        <div>
          <span class="directory-results-kicker">ALPHABETICAL ENTRIES</span>
          <h3 data-directory-title>All headwords</h3>
        </div>
        <p data-directory-count aria-live="polite">Browse {orderedTerms.length} entries</p>
      </div>
      <ol class="directory-entry-list" data-directory-entries>
        {orderedTerms.map((term) => (
          <li class="directory-entry"
              data-letter={term.label.charAt(0).toUpperCase()}
              data-subjects={subjectSlugsForTerm(term).join(' ')}
              data-search={[term.label, term.slug, term.short_definition, term.category, ...(term.aliases ?? []).map((alias) => alias.label)].filter(Boolean).join(' ').toLowerCase()}>
            <div class="directory-entry-main">
              <a href={'/terms/' + term.slug + '/'}>{term.label}<span class="entry-arrow" aria-hidden="true">↗</span></a>
              <p>{term.short_definition}</p>
              {term.aliases?.length > 0 && <span class="directory-entry-alias">Also: {term.aliases.slice(0,2).map((alias) => alias.label).join(' · ')}</span>}
            </div>
            <span class="directory-entry-type">{term.category}</span>
          </li>
        ))}
      </ol>
      <p class="directory-empty" data-directory-empty hidden>No entries match these filters. Try a different name or choose another subject.</p>
      <button type="button" class="directory-more" data-directory-more hidden>Show more entries <span aria-hidden="true">↓</span></button>
    </div>

    <aside class="directory-shelf" aria-label="Historical source library">
      <div class="directory-shelf-panel">
        <p class="directory-shelf-kicker">RESEARCH LIBRARY</p>
        <h3>Historical witnesses</h3>
        <p>Definitions are accompanied by the traditions and authors through which they were transmitted.</p>
        <h4>Selected authors</h4>
        <ul>
          {authorList.map((author) => <li><a href={'/authors/' + author.slug + '/'}>{author.name}</a></li>)}
        </ul>
        <a class="directory-shelf-link" href="/authors/">All authors <span aria-hidden="true">↗</span></a>
      </div>
      <div class="directory-shelf-panel directory-shelf-works">
        <h4>Primary works</h4>
        <ul>
          {workList.map((work) => <li><a href={'/works/' + work.slug + '/'}>{work.title}</a></li>)}
        </ul>
        <a class="directory-shelf-link" href="/works/">Explore the bibliography <span aria-hidden="true">↗</span></a>
      </div>
    </aside>
  </div>
</section>

<script>
  document.querySelectorAll('[data-directory]').forEach((root) => {
    const search = root.querySelector('[data-directory-search]');
    const rows = [...root.querySelectorAll('.directory-entry')];
    const letterButtons = [...root.querySelectorAll('[data-directory-letter]')];
    const subjectButtons = [...root.querySelectorAll('[data-directory-subject]')];
    const count = root.querySelector('[data-directory-count]');
    const title = root.querySelector('[data-directory-title]');
    const more = root.querySelector('[data-directory-more]');
    const empty = root.querySelector('[data-directory-empty]');
    const toggle = root.querySelector('[data-topic-toggle]');
    const subjects = root.querySelector('#directory-subjects');
    let letter = 'ALL';
    let subject = 'ALL';
    let limit = 24;

    const normalized = (value) => (value || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const subjectTitle = () => subjectButtons.find((button) => button.dataset.directorySubject === subject)?.querySelector('span')?.textContent || 'All headwords';

    function readUrl() {
      const url = new URL(window.location.href);
      const requested = (url.hash || '').slice(1).toUpperCase();
      letter = /^[A-Z]$/.test(requested) && rows.some((row) => row.dataset.letter === requested) ? requested : 'ALL';
      const namedSubject = url.searchParams.get('subject');
      subject = subjectButtons.some((button) => button.dataset.directorySubject === namedSubject) ? namedSubject : 'ALL';
    }
    function writeUrl() {
      const url = new URL(window.location.href);
      if (subject === 'ALL') url.searchParams.delete('subject');
      else url.searchParams.set('subject', subject);
      url.hash = letter === 'ALL' ? '' : letter;
      window.history.replaceState(null, '', url.pathname + url.search + url.hash);
    }
    function apply() {
      const q = normalized(search.value.trim());
      const matches = rows.filter((row) => {
        const byLetter = letter === 'ALL' || row.dataset.letter === letter;
        const bySubject = subject === 'ALL' || (row.dataset.subjects || '').split(' ').includes(subject);
        return byLetter && bySubject && (!q || normalized(row.dataset.search).includes(q));
      });
      const visible = new Set(matches.slice(0, limit));
      rows.forEach((row) => { row.hidden = !visible.has(row); });
      letterButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.directoryLetter === letter)));
      subjectButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.directorySubject === subject)));
      title.textContent = q ? 'Search results' : subject !== 'ALL' ? subjectTitle() : letter !== 'ALL' ? 'Letter ' + letter : 'All headwords';
      count.textContent = matches.length ? 'Showing ' + Math.min(limit, matches.length) + ' of ' + matches.length : '0 entries';
      more.hidden = matches.length <= limit;
      empty.hidden = matches.length > 0;
    }
    readUrl();
    apply();
    letterButtons.forEach((button) => button.addEventListener('click', () => {
      letter = button.dataset.directoryLetter;
      limit = 24;
      writeUrl();
      apply();
    }));
    subjectButtons.forEach((button) => button.addEventListener('click', () => {
      subject = button.dataset.directorySubject;
      letter = 'ALL';
      limit = 24;
      writeUrl();
      apply();
      if (window.matchMedia('(max-width: 820px)').matches) {
        subjects.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    }));
    search.addEventListener('input', () => {
      letter = 'ALL';
      limit = 24;
      writeUrl();
      apply();
    });
    more.addEventListener('click', () => { limit += 24; apply(); });
    toggle.addEventListener('click', () => {
      const open = subjects.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === '/' && !['INPUT','TEXTAREA'].includes(document.activeElement?.tagName) && !event.metaKey && !event.ctrlKey) {
        event.preventDefault();
        search.focus();
      }
    });
    window.addEventListener('popstate', () => { readUrl(); limit = 24; apply(); });
    window.addEventListener('hashchange', () => { readUrl(); limit = 24; apply(); });
  });
</script>

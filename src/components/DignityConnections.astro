---
const { assignments = [], termSlug } = Astro.props;

const schemes = [...new Map(assignments.map((item) => [item.scheme_slug, item])).values()];
const asPlanet = assignments.some((item) => item.planet_slug === termSlug);
const asSign = assignments.some((item) => item.sign_slug === termSlug);

const grouped = (schemeSlug, mode) => assignments
  .filter((item) => item.scheme_slug === schemeSlug && (mode === 'planet' ? item.planet_slug === termSlug : item.sign_slug === termSlug));

const range = (item) => `${Number(item.degree_start)}–${Number(item.degree_end)}°`;
const exact = (item) => item.exact_degree_number ? ` · ${item.exact_degree_number}°` : '';
const sect = (item) => item.sect_condition === 'any' ? 'day & night' : item.sect_condition;
const typeLabel = (type) => ({
  domicile:'Domicile', exaltation:'Exaltation', triplicity:'Triplicity', term:'Term / bound',
  face:'Face / decan', detriment:'Detriment / exile', fall:'Fall'
}[type] ?? type);
---

{schemes.map((scheme) => {
  const planetRows = asPlanet ? grouped(scheme.scheme_slug,'planet') : [];
  const signRows = asSign ? grouped(scheme.scheme_slug,'sign') : [];
  return (planetRows.length || signRows.length) && (
    <section class="dignity-connections" id={`dignity-${scheme.scheme_slug}`}>
      <div class="connection-head">
        <div>
          <p class="micro-label">Structured dignity data</p>
          <h2>Dignity relationships</h2>
        </div>
        <p>{scheme.scheme_label}</p>
      </div>

      {planetRows.length > 0 && <div class="connection-group">
        <h3>Where this planet participates</h3>
        <div class="table-scroll" tabindex="0">
          <table>
            <thead><tr><th>Role</th><th>Sign</th><th>Sect</th><th>Degree span / degree</th></tr></thead>
            <tbody>{planetRows.map((item) => <tr>
              <td>{typeLabel(item.assignment_type)}</td>
              <td><a href={`/terms/${item.sign_slug}/`}>{item.sign_label}</a></td>
              <td>{item.assignment_type === 'triplicity' ? sect(item) : '—'}</td>
              <td>{['term','face'].includes(item.assignment_type) ? range(item) : (item.exact_degree_number ? `${item.exact_degree_number}°` : 'whole sign')}</td>
            </tr>)}</tbody>
          </table>
        </div>
      </div>}

      {signRows.length > 0 && <div class="connection-group">
        <h3>Dignities operating in this sign</h3>
        <div class="table-scroll" tabindex="0">
          <table>
            <thead><tr><th>Role</th><th>Planet</th><th>Sect</th><th>Degree span / degree</th></tr></thead>
            <tbody>{signRows.map((item) => <tr>
              <td>{typeLabel(item.assignment_type)}</td>
              <td><a href={`/terms/${item.planet_slug}/`}>{item.planet_label}</a>{exact(item)}</td>
              <td>{item.assignment_type === 'triplicity' ? sect(item) : '—'}</td>
              <td>{['term','face'].includes(item.assignment_type) ? range(item) : (item.exact_degree_number ? `${item.exact_degree_number}°` : 'whole sign')}</td>
            </tr>)}</tbody>
          </table>
        </div>
      </div>}
    </section>
  );
})}

<style>
  .dignity-connections{margin:2.8rem 0}
  .connection-head{display:flex;gap:1.5rem;align-items:flex-end;justify-content:space-between;border-bottom:1px solid var(--line-dark);padding-bottom:.75rem;margin-bottom:1.2rem}
  .connection-head h2{margin:.15rem 0 0}.connection-head>p{color:var(--muted);font-size:.82rem;text-align:right}
  .connection-group+ .connection-group{margin-top:1.7rem}.connection-group h3{margin:0 0 .7rem}
  .table-scroll{overflow-x:auto;border:1px solid var(--line-dark);background:var(--paper-pale)}
  table{width:100%;border-collapse:collapse;min-width:38rem;font-size:.88rem}
  th,td{padding:.7rem .8rem;text-align:left;vertical-align:top;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
  th:last-child,td:last-child{border-right:0}tbody tr:last-child td{border-bottom:0}
  thead th{font:700 .66rem/1.3 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;text-transform:uppercase;letter-spacing:.06em;background:var(--paper-deep);white-space:nowrap}
  td:first-child{font-weight:600}a{text-decoration:none;border-bottom:1px dotted currentColor}a:hover{border-bottom-style:solid}
  .table-scroll:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  @media(max-width:720px){.connection-head{display:block}.connection-head>p{text-align:left;margin-top:.5rem}}
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { terms } from '../../data/preview';
import { definitionOverrides } from '../../data/definitionOverrides';

export function getStaticPaths() {
  return terms
    .filter((term) => term.slug !== 'reception')
    .map((term) => ({ params: { slug: term.slug }, props: { term } }));
}

const { term } = Astro.props;
const definition = definitionOverrides[term.slug] ?? term.definition;
---
<BaseLayout title={`${term.label} — Astrological Lexicon`} description={`${term.label}: ${definition}`}>
  <div class="shell page-grid">
    <aside class="article-rail" aria-label="Entry metadata">
      <div class="rail-group">
        <span class="micro-label">Entry type</span>
        <span class="rail-value">Technical term</span>
      </div>
      <div class="rail-group">
        <span class="micro-label">Subject</span>
        <span class="rail-value">{term.category}</span>
      </div>
      <div class="rail-group">
        <span class="micro-label">Edition</span>
        <span class="rail-value">Research preview</span>
      </div>
    </aside>

    <article class="article">
      <p class="eyebrow">Lexicon entry · {term.category}</p>
      <h1>{term.label}</h1>
      <p class="lede">{definition}</p>

      <div class="definition-panel" id="definition">
        <p class="micro-label">Canonical definition</p>
        <p>{definition}</p>
      </div>

      <section id="names">
        <h2>Names & historical forms</h2>
        <p class="meta">Aliases, translated forms and author-specific terminology will be generated here from the canonical database.</p>
        <div class="term-links">
          <span>{term.label}</span>
        </div>
      </section>

      <section id="sources">
        <h2>Source accounts</h2>
        <div class="source-block">
          <div class="source-head">
            <h3>Reviewed source witnesses</h3>
            <span class="source-label">Database integration pending</span>
          </div>
          <p>The extraction corpus already contains source-specific interpretations, editions and locators for this term where definition-level evidence was found. This redesigned section is the target for those records once the canonical SQLite/D1 data layer replaces the temporary preview dataset.</p>
          <p class="source-cite"><span class="evidence">A/B</span>Only reviewed definition-level or substantial explanatory evidence is intended for public source accounts.</p>
        </div>
      </section>

      <section id="comparison">
        <h2>Historical comparison</h2>
        <p>Where multiple authors define or materially explain the same concept, this section will distinguish shared recognition rules from historical differences, competing doctrines and translator-dependent terminology.</p>
      </section>

      <section id="related">
        <h2>Related concepts</h2>
        <p class="meta">These links will be generated from reviewed term relations rather than a hand-maintained list.</p>
        <div class="term-links">
          <a href="/">Browse all terms</a>
          <a href="/terms/reception">Reception</a>
          <a href="/terms/application">Application</a>
          <a href="/terms/combustion">Combustion</a>
        </div>
      </section>
    </article>

    <aside class="toc">
      <strong>On this entry</strong>
      <a href="#definition">Definition</a>
      <a href="#names">Names & forms</a>
      <a href="#sources">Source accounts</a>
      <a href="#comparison">Comparison</a>
      <a href="#related">Related concepts</a>
    </aside>
  </div>
</BaseLayout>

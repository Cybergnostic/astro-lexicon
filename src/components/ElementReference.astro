---
const { elementLabel, signs = [], schemes = [] } = Astro.props;

const planetGlyphs = { sun:'☉', moon:'☽', mercury:'☿', venus:'♀', mars:'♂', jupiter:'♃', saturn:'♄' };
const primarySymbol = (term) => term.symbols?.find((item) => item.is_primary)?.symbol_text ?? term.symbols?.[0]?.symbol_text ?? '•';
const triplicitySchemes = schemes.filter((scheme) => scheme.assignments?.some((item) => item.assignment_type === 'triplicity'));
const representativeSign = signs[0]?.slug;
const ruler = (scheme, sect) => scheme.assignments?.find((item) => item.assignment_type === 'triplicity' && item.sign_slug === representativeSign && item.sect_condition === sect);
const rulerCell = (item) => item ? { slug:item.planet_slug, label:item.planet_label, glyph:planetGlyphs[item.planet_slug] ?? '•' } : null;
---

<section class="element-reference" id="element-reference">
  <div class="reference-head">
    <div>
      <p class="micro-label">Elemental triplicity</p>
      <h2>{elementLabel} signs & triplicity rulers</h2>
    </div>
  </div>

  <div class="reference-grid">
    <div>
      <h3>Signs in this element</h3>
      <div class="table-scroll" tabindex="0">
        <table class="element-table sign-table">
          <thead><tr><th>Sign</th><th>Modality</th></tr></thead>
          <tbody>
            {signs.map((sign) => <tr>
              <th scope="row"><a href={`/terms/${sign.slug}/`}><span class="sign-glyph" aria-hidden="true">{primarySymbol(sign)}</span>{sign.label}</a></th>
              <td>{sign.zodiac_sign_profile?.modality_label ?? '—'}</td>
            </tr>)}
          </tbody>
        </table>
      </div>
    </div>

    <div>
      <h3>Triplicity rulers</h3>
      <div class="table-scroll" tabindex="0">
        <table class="element-table ruler-table">
          <thead><tr><th>Scheme</th><th>Day</th><th>Night</th><th>Third / both</th></tr></thead>
          <tbody>
            {triplicitySchemes.map((scheme) => {
              const day = rulerCell(ruler(scheme,'day'));
              const night = rulerCell(ruler(scheme,'night'));
              const any = rulerCell(ruler(scheme,'any'));
              return <tr>
                <th scope="row">{scheme.label}</th>
                {[day,night,any].map((item) => <td class="ruler-cell">{item ? <a href={`/terms/${item.slug}/`} title={item.label}><span aria-hidden="true">{item.glyph}</span><span class="sr-only">{item.label}</span></a> : '—'}</td>)}
              </tr>;
            })}
          </tbody>
        </table>
      </div>
      <p class="reference-note">Rulers are shown by named historical scheme rather than collapsed into one universal table.</p>
    </div>
  </div>
</section>

<style>
  .element-reference{margin:3rem 0;scroll-margin-top:1rem}
  .reference-head{border-bottom:1px solid var(--line-dark);padding-bottom:.8rem;margin-bottom:1rem}.reference-head h2{margin:.15rem 0 0}
  .reference-grid{display:grid;grid-template-columns:minmax(16rem,.8fr) minmax(28rem,1.4fr);gap:1.4rem;align-items:start}
  .reference-grid h3{margin:0 0 .55rem;font-size:.82rem;text-transform:uppercase;letter-spacing:.055em}
  .table-scroll{overflow-x:auto;border:1px solid var(--line-dark);background:var(--paper-pale)}
  .element-table{width:100%;border-collapse:collapse;font-size:.83rem}.element-table th,.element-table td{padding:.62rem .7rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line);text-align:left;vertical-align:middle}.element-table tr>*:last-child{border-right:0}.element-table tbody tr:last-child>*{border-bottom:0}
  .element-table thead th{font:700 .58rem/1.3 var(--font-ui,ui-sans-serif,system-ui,sans-serif);text-transform:uppercase;letter-spacing:.055em;background:var(--paper-deep)}
  .element-table tbody th{font-weight:650;background:color-mix(in srgb,var(--paper-deep) 55%,transparent)}
  .sign-table th a{display:flex;align-items:center;gap:.55rem;color:var(--ink);text-decoration:none}.sign-table th a:hover{color:var(--accent)}.sign-glyph{font-family:var(--glyph-font);font-size:1.35rem;line-height:1}
  .ruler-table th:first-child{width:52%}.ruler-table td{text-align:center}.ruler-cell a{display:inline-flex;color:var(--ink);text-decoration:none;font-family:var(--glyph-font);font-size:1.45rem;line-height:1}.ruler-cell a:hover{color:var(--accent)}
  .reference-note{margin:.65rem 0 0;color:var(--muted);font-size:.78rem;max-width:34rem}.table-scroll:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  @media(max-width:900px){.reference-grid{grid-template-columns:1fr}.ruler-table{min-width:34rem}}
</style>
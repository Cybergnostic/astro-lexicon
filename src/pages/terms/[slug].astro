---
import BaseLayout from '../../layouts/BaseLayout.astro';
import corpus from '../../data/generated/corpus.json';

export function getStaticPaths() {
  return corpus.terms.map((term) => ({ params: { slug: term.slug }, props: { term } }));
}

const { term } = Astro.props;
const article = term.article;
const articleBlocks = article?.blocks ?? article?.sections?.map((section) => ({ type: 'section', ...section })) ?? [];
const sourceAuthors=[...new Set(term.interpretations.map((item)=>item.author_name))];
const citationLabel=(citation) => {
  const locus=[citation.book,citation.tractate,citation.chapter,citation.section].filter(Boolean).join(' · ');
  const pages=citation.page_start ? `pp. ${citation.page_start}${citation.page_end && citation.page_end !== citation.page_start ? `–${citation.page_end}` : ''}` : '';
  return [locus,pages,citation.locator_text].filter(Boolean).join(' · ');
};
---
<BaseLayout title={`${term.label} — Astrological Lexicon`} description={term.short_definition}>
  <div class="shell page-grid">
    <aside class="article-rail" aria-label="Entry metadata">
      <div class="rail-group"><span class="micro-label">Entry type</span><span class="rail-value">{term.entry_type}</span></div>
      <div class="rail-group"><span class="micro-label">Subject</span><span class="rail-value">{term.category}</span></div>
      <div class="rail-group"><span class="micro-label">Definition quality</span><span class="rail-value">{term.definition_quality}/5</span></div>
      <div class="rail-group"><span class="micro-label">Source witnesses</span><span class="rail-value">{sourceAuthors.length}</span></div>
      {article && <div class="rail-group"><span class="micro-label">Teaching article</span><span class="rail-value">Reviewed</span></div>}
    </aside>

    <article class="article">
      <p class="eyebrow">Lexicon entry · {term.category}</p>
      <h1>{term.label}</h1>
      <p class="lede">{term.short_definition}</p>

      {!article && <div class="definition-panel" id="definition"><p class="micro-label">Canonical definition</p><p>{term.short_definition}</p></div>}

      {article && <section id="overview" class="article-overview">
        <h2>Overview</h2>
        <p>{article.intro}</p>
      </section>}

      {articleBlocks.map((block) => block.type === 'table' ? (
        <section id={block.table_key} class="article-table-section">
          <h2>{block.heading}</h2>
          {block.caption && <p class="table-caption">{block.caption}</p>}
          <div class="table-scroll" tabindex="0">
            <table class="article-table">
              <thead><tr>{block.columns.map((column) => <th scope="col">{column}</th>)}</tr></thead>
              <tbody>{block.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
            </table>
          </div>
        </section>
      ) : (
        <section id={block.section_key}>
          <h2>{block.heading}</h2>
          <p>{block.body}</p>
        </section>
      ))}

      <section id="names">
        <h2>Names & historical forms</h2>
        {term.aliases.length ? <div class="term-links">{term.aliases.map((alias)=><span title={alias.scope_note || undefined}>{alias.label}</span>)}</div> : <p class="meta">No separate alias is currently recorded for this entry.</p>}
      </section>

      <section id="sources">
        <h2>Source accounts</h2>
        {term.interpretations.map((item)=><div class="source-block">
          <div class="source-head"><h3>{item.author_name} · <em>{item.work_title}</em></h3><span class="source-label">Evidence {item.evidence_grade}</span></div>
          <p>{item.summary}</p>
          {item.citations.map((citation)=><p class="source-cite"><span class="evidence">{item.evidence_grade}</span>{citationLabel(citation)}{citation.edition_label ? ` · ${citation.edition_label}` : ''}</p>)}
        </div>)}
      </section>

      {term.interpretations.length > 1 && <section id="comparison"><h2>Historical comparison</h2><p>This concept is attested by {sourceAuthors.length} source witness{sourceAuthors.length === 1 ? '' : 'es'} in the current corpus. Their accounts are kept separately above so differences in terminology, mechanism and emphasis remain attributable rather than being collapsed into the canonical definition.</p></section>}

      <section id="related">
        <h2>Related concepts</h2>
        {term.relations.length ? <div class="term-links">{term.relations.map((relation)=><a href={`/terms/${relation.target_slug}/`} title={relation.note || undefined}>{relation.target_label}</a>)}</div> : <p class="meta">No reviewed term relations are currently recorded.</p>}
      </section>

      {term.editorial_notes && <section id="editorial"><h2>Editorial note</h2><p>{term.editorial_notes}</p></section>}
    </article>

    <aside class="toc">
      <strong>On this entry</strong>
      {!article && <a href="#definition">Definition</a>}
      {article && <a href="#overview">Overview</a>}
      {articleBlocks.map((block)=><a href={`#${block.type === 'table' ? block.table_key : block.section_key}`}>{block.heading}</a>)}
      <a href="#names">Names & forms</a>
      <a href="#sources">Source accounts</a>
      {term.interpretations.length > 1 && <a href="#comparison">Comparison</a>}
      <a href="#related">Related concepts</a>
      {term.editorial_notes && <a href="#editorial">Editorial note</a>}
    </aside>
  </div>
</BaseLayout>

<style>
  .table-caption{margin:-.25rem 0 1rem;color:var(--muted);font-size:.92rem;max-width:42rem}
  .table-scroll{overflow-x:auto;border:1px solid var(--line-dark);background:var(--paper-pale)}
  .article-table{width:100%;border-collapse:collapse;min-width:34rem;font-size:.91rem}
  .article-table th,.article-table td{padding:.78rem .85rem;text-align:left;vertical-align:top;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
  .article-table th:last-child,.article-table td:last-child{border-right:0}
  .article-table tbody tr:last-child td{border-bottom:0}
  .article-table th{font:700 .68rem/1.35 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;text-transform:uppercase;letter-spacing:.07em;background:var(--paper-deep);white-space:nowrap}
  .article-table td:first-child{font-weight:600}
  .table-scroll:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  @media(max-width:720px){.article-table{min-width:30rem}.article-table th,.article-table td{padding:.68rem .72rem}}
</style>

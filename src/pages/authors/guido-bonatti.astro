---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Guido Bonatti — Astrological Lexicon">
  <div class="shell page-grid">
    <article class="article">
      <p class="eyebrow">Author · Medieval Latin tradition</p>
      <h1>Guido<br />Bonatti</h1>
      <p class="lede">Medieval astrologer and author of the <em>Liber Astronomiae</em>. This page will become an index of concepts, passages, and terminology attributed directly to Bonatti in the source corpus.</p>

      <section id="works">
        <h2>Works in this database</h2>
        <div class="source-block">
          <div class="source-head">
            <h3>Liber Astronomiae</h3>
            <span class="source-label">13th century</span>
          </div>
          <p>Initial research edition: Project Hindsight translation, Robert Zoller; edited by Robert Hand.</p>
          <p class="source-cite">The project keeps translator/editor commentary separate from text attributed to Bonatti.</p>
        </div>
      </section>

      <section id="concepts">
        <h2>Concepts being indexed</h2>
        <ul class="list-clean">
          <li><a href="#">Triplicity rulers</a><span class="count">verified passage</span></li>
          <li><a href="#">Combustion</a><span class="count">verified passage</span></li>
          <li><a href="/terms/reception">Reception</a><span class="count">review pending</span></li>
          <li><a href="#">Terms / Bounds</a><span class="count">review pending</span></li>
          <li><a href="#">Application</a><span class="count">review pending</span></li>
        </ul>
      </section>

      <section id="note">
        <h2>Editorial note</h2>
        <p>This edition contains substantial historical notes by its modern editors. Those notes are useful evidence about transmission and terminology, but they are not treated as statements by Bonatti. The database records direct source passages and secondary editorial material separately.</p>
      </section>
    </article>

    <aside class="toc">
      <strong>Author index</strong>
      <a href="#works">Works</a>
      <a href="#concepts">Concepts</a>
      <a href="#note">Editorial note</a>
    </aside>
  </div>
</BaseLayout>

---
const { forms = [] } = Astro.props;

const renderingLabel = (type) => ({
  preferred: 'Preferred rendering',
  translation: 'Translation',
  variant: 'Variant rendering',
  literal: 'Literal rendering',
  'false-friend': 'False friend'
}[type] ?? type);
---

{forms.length > 0 && <div class="historical-forms">
  {forms.map((form) => <article class="form-card">
    <div class="form-head">
      <div>
        <p class="form-script" lang={form.language_code === 'grc' ? 'grc' : undefined}>{form.form}</p>
        {form.transliteration && <p class="form-transliteration">{form.transliteration}</p>}
      </div>
      <span class="form-language">{form.language_code === 'grc' ? 'Ancient Greek' : form.language_code}{form.script ? ` · ${form.script}` : ''}</span>
    </div>

    <dl class="form-details">
      {form.lemma && form.lemma !== form.form && <><dt>Lemma</dt><dd lang={form.language_code === 'grc' ? 'grc' : undefined}>{form.lemma}</dd></>}
      {form.literal_gloss && <><dt>Literal gloss</dt><dd>{form.literal_gloss}</dd></>}
      {form.renderings?.length > 0 && <><dt>English renderings</dt><dd class="renderings">{form.renderings.map((item) => <span>
        <strong>{renderingLabel(item.rendering_type)} · {item.rendering}</strong>
        {item.scope_note && <small>{item.scope_note}</small>}
      </span>)}</dd></>}
      {form.ambiguity_note && <><dt>Translation note</dt><dd>{form.ambiguity_note}</dd></>}
    </dl>

    {form.attestations?.length > 0 && <div class="form-sources">
      <strong>Attestation / scope</strong>
      {form.attestations.map((item) => <p>
        {item.tradition_scope && <span>{item.tradition_scope}</span>}
        {item.work_title && <span>
          {item.author_name && item.author_slug ? <><a href={`/authors/${item.author_slug}/`}>{item.author_name}</a> · </> : item.author_name ? `${item.author_name} · ` : ''}
          <em>{item.work_slug ? <a href={`/works/${item.work_slug}/`}>{item.work_title}</a> : item.work_title}</em>
        </span>}
        {item.external_source_label && <span>{item.external_source_url ? <a href={item.external_source_url} rel="noreferrer">{item.external_source_label}</a> : item.external_source_label}</span>}
        {item.source_note && <span>{item.source_note}</span>}
      </p>)}
    </div>}
  </article>)}
</div>}

<style>
  .historical-forms{display:grid;gap:.85rem;margin:1rem 0 0}
  .form-card{border:1px solid var(--line-dark);background:var(--paper-pale);padding:1rem 1.05rem}
  .form-head{display:flex;align-items:flex-start;justify-content:space-between;gap:1.25rem;border-bottom:1px solid var(--line);padding-bottom:.7rem;margin-bottom:.8rem}
  .form-script{font-size:1.55rem;line-height:1.2;margin:0;font-family:Georgia,"Times New Roman",serif}
  .form-transliteration{margin:.25rem 0 0;color:var(--muted);font-style:italic}
  .form-language{font:700 .62rem/1.3 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);text-align:right}
  .form-details{display:grid;grid-template-columns:minmax(8rem,10rem) 1fr;gap:.45rem .9rem;margin:0}
  .form-details dt{font-weight:700;font-size:.8rem;color:var(--muted)}
  .form-details dd{margin:0}
  .renderings{display:flex;flex-wrap:wrap;gap:.35rem}
  .renderings span{border:1px solid var(--line);padding:.28rem .45rem;font-size:.8rem;background:var(--paper-deep)}
  .renderings strong,.renderings small{display:block}.renderings strong{font-weight:600}.renderings small{margin-top:.16rem;color:var(--muted);font-size:.7rem;max-width:28rem}
  .form-sources{border-top:1px solid var(--line);margin-top:.8rem;padding-top:.7rem;font-size:.82rem;color:var(--muted)}
  .form-sources>strong{display:block;color:var(--ink);margin-bottom:.3rem}
  .form-sources p{margin:.35rem 0}.form-sources span{display:block}
  .form-sources a{color:inherit;text-decoration:none;border-bottom:1px dotted currentColor}.form-sources a:hover{color:var(--ink);border-bottom-style:solid}
  @media(max-width:620px){.form-head{display:block}.form-language{display:block;text-align:left;margin-top:.45rem}.form-details{grid-template-columns:1fr}.form-details dt{margin-top:.3rem}}
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AstronomyMechanics from '../../components/AstronomyMechanics.astro';
import ConceptFamilyMap from '../../components/ConceptFamilyMap.astro';
import DignityReference from '../../components/DignityReference.astro';
import DignityConnections from '../../components/DignityConnections.astro';
import HistoricalForms from '../../components/HistoricalForms.astro';
import LotMechanics from '../../components/LotMechanics.astro';
import PlanetProfile from '../../components/PlanetProfile.astro';
import PlanetaryCycle from '../../components/PlanetaryCycle.astro';
import PlanetaryOrder from '../../components/PlanetaryOrder.astro';
import PlanetaryTimeSequences from '../../components/PlanetaryTimeSequences.astro';
import ZodiacRelations from '../../components/ZodiacRelations.astro';
import ZodiacSignProfile from '../../components/ZodiacSignProfile.astro';
import corpus from '../../data/generated/corpus.json';

export function getStaticPaths() {
  return corpus.terms.map((term) => ({ params: { slug: term.slug }, props: { term } }));
}

const { term } = Astro.props;
const article = term.article;
const articleBlocks = article?.blocks ?? article?.sections?.map((section) => ({ type: 'section', ...section })) ?? [];
const pageComposition = term.page_composition ?? [];
const hasComposition = pageComposition.length > 0;
const articleSectionsByKey = new Map((article?.sections ?? []).map((section) => [section.section_key, section]));
const articleTablesByKey = new Map((article?.tables ?? []).map((table) => [table.table_key, table]));
const sourceAuthors=[...new Set(term.interpretations.map((item)=>item.author_name))];
const primarySymbol=term.symbols?.find((item)=>item.is_primary) ?? term.symbols?.[0] ?? null;
const hasHistoricalForms=(term.forms?.length ?? 0) > 0;
const hasAliases=(term.aliases?.length ?? 0) > 0;
const hasNames=hasHistoricalForms || hasAliases;
const hasPlanetProfile=Boolean(term.planet_profile);
const hasZodiacSignProfile=Boolean(term.zodiac_sign_profile);
const hasConceptFamilies=(term.concept_families?.length ?? 0) > 0;
const hasLotDiagram=(term.concept_families?.some((family) => ['lot-mechanics','abu-mashar-planetary-lots'].includes(family.slug)) ?? false);
const hasPlanetaryOrderDiagram=(term.concept_families?.some((family) => family.slug === 'traditional-planetary-order') ?? false);
const hasPlanetaryTimeSequences=(term.planetary_time_sequences?.length ?? 0) > 0;
const hasZodiacRelations=(term.zodiac_relation_schemes?.length ?? 0) > 0;
const astronomyDiagramSlugs=new Set([
  'celestial-sphere','horizon','meridian','equinoctial','ecliptic','declination','celestial-latitude','celestial-longitude','ecliptic-projection',
  'first-movement','second-movement','direct-motion','station','retrogradation','swift-in-motion','slow-in-motion',
  'oriental','occidental','combustion','under-the-beams','cazimi',
  'eclipse','solar-eclipse','lunar-eclipse','total-eclipse','partial-eclipse','annular-eclipse','occultation','eclipse-path'
]);
const hasAstronomyDiagram=astronomyDiagramSlugs.has(term.slug);
const planetaryLots=term.relations?.filter((relation) => relation.direction === 'outgoing' && relation.relation_type === 'associated-planetary-lot') ?? [];
const hasReferenceSchemes=(term.reference_schemes?.length ?? 0) > 0;
const hasReferenceAssignments=(term.reference_assignments?.length ?? 0) > 0;
const hasCycles=(term.cycles?.length ?? 0) > 0;
const hasSources=(term.interpretations?.length ?? 0) > 0;
const hasRelations=(term.relations?.length ?? 0) > 0;
const firstReferenceId=hasReferenceSchemes
  ? `reference-${term.reference_schemes.find((scheme) => scheme.assignments.some((item) => item.assignment_type !== 'term'))?.slug ?? 'terms-comparison'}`
  : hasReferenceAssignments
    ? `dignity-${term.reference_assignments[0].scheme_slug}`
    : null;
const firstCycleId=hasCycles ? `cycle-${term.cycles[0].slug}` : null;
const firstFamilyId=hasConceptFamilies ? `family-${term.concept_families[0].slug}` : null;
const citationLabel=(citation) => {
  const locus=[citation.book,citation.tractate,citation.chapter,citation.section].filter(Boolean).join(' · ');
  const pages=citation.page_start ? `pp. ${citation.page_start}${citation.page_end && citation.page_end !== citation.page_start ? `–${citation.page_end}` : ''}` : '';
  return [locus,pages,citation.locator_text].filter(Boolean).join(' · ');
};
const humanizeKey=(value='') => value.replaceAll('-', ' ').replace(/\b\w/g, (char) => char.toUpperCase());
const relationLabel=(relation) => `${humanizeKey(relation.relation_type)} · ${relation.direction}`;
---
<BaseLayout title={`${term.label} — Astrological Lexicon`} description={term.short_definition}>
  <div class="shell page-grid">
    <aside class="article-rail" aria-label="Entry information">
      <div class="rail-group"><span class="micro-label">Entry type</span><span class="rail-value">{term.entry_type}</span></div>
      <div class="rail-group"><span class="micro-label">Subject</span><span class="rail-value">{term.category}</span></div>
      {sourceAuthors.length > 0 && <div class="rail-group"><span class="micro-label">Sources</span><span class="rail-value">{sourceAuthors.length} author{sourceAuthors.length === 1 ? '' : 's'}</span></div>}
    </aside>

    <article class="article">
      <p class="eyebrow">Lexicon entry · {term.category}</p>
      <div class="title-row">
        <h1>{term.label}</h1>
        {primarySymbol && <span class="entry-glyph" role="img" aria-label={primarySymbol.label || `${term.label} symbol`}>{primarySymbol.symbol_text}</span>}
      </div>
      <p class="lede">{term.short_definition}</p>

      {article?.intro && <div class="article-intro" id="overview"><p>{article.intro}</p></div>}

      {hasComposition ? pageComposition.map((publicSection) => (
        <section id={`section-${publicSection.section_key}`} class="composed-section">
          <h2>{publicSection.heading}</h2>
          <div class="composed-flow">
            {publicSection.blocks.map((block) => {
              const source = block.source_kind === 'article-section'
                ? articleSectionsByKey.get(block.source_key)
                : block.source_kind === 'article-table'
                  ? articleTablesByKey.get(block.source_key)
                  : null;
              if (!source) return null;

              if (block.source_kind === 'article-table') {
                return <div class="composed-block composed-table-block" id={source.table_key}>
                  {block.show_heading && <h3>{source.heading}</h3>}
                  {source.caption && <p class="table-caption">{source.caption}</p>}
                  <div class="table-scroll" tabindex="0">
                    <table class="article-table">
                      <thead><tr>{source.columns.map((column) => <th scope="col">{column}</th>)}</tr></thead>
                      <tbody>{source.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
                    </table>
                  </div>
                </div>;
              }

              return <div class:list={['composed-block', { subsection: block.presentation_role === 'subsection' }]} id={source.section_key}>
                {block.show_heading && <h3>{source.heading}</h3>}
                <p>{source.body}</p>
              </div>;
            })}
          </div>
        </section>
      )) : articleBlocks.map((block) => block.type === 'table' ? (
        <section id={block.table_key} class="article-table-section">
          <h2>{block.heading}</h2>
          {block.caption && <p class="table-caption">{block.caption}</p>}
          <div class="table-scroll" tabindex="0">
            <table class="article-table">
              <thead><tr>{block.columns.map((column) => <th scope="col">{column}</th>)}</tr></thead>
              <tbody>{block.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
            </table>
          </div>
        </section>
      ) : (
        <section id={block.section_key}>
          <h2>{block.heading}</h2>
          <p>{block.body}</p>
        </section>
      ))}

      {hasConceptFamilies && <ConceptFamilyMap families={term.concept_families} currentSlug={term.slug} />}
      {hasLotDiagram && <LotMechanics families={term.concept_families} />}
      {hasPlanetaryOrderDiagram && <PlanetaryOrder families={term.concept_families} />}
      {hasPlanetaryTimeSequences && <PlanetaryTimeSequences sequences={term.planetary_time_sequences} />}
      {hasZodiacRelations && <ZodiacRelations schemes={term.zodiac_relation_schemes} currentSlug={term.slug} />}
      {hasAstronomyDiagram && <AstronomyMechanics slug={term.slug} />}
      {hasZodiacSignProfile && <ZodiacSignProfile profile={term.zodiac_sign_profile} />}
      {hasPlanetProfile && <PlanetProfile profile={term.planet_profile} lots={planetaryLots} />}
      {hasReferenceSchemes && <DignityReference schemes={term.reference_schemes} />}
      {hasReferenceAssignments && <DignityConnections assignments={term.reference_assignments} termSlug={term.slug} />}
      {hasCycles && <PlanetaryCycle cycles={term.cycles} />}

      {hasNames && <section id="names">
        <h2>Names & historical forms</h2>
        {hasHistoricalForms && <HistoricalForms forms={term.forms} />}
        {hasAliases && <div class="alias-group">
          {hasHistoricalForms && <h3>Other names</h3>}
          <div class="alias-list">{term.aliases.map((alias)=><div class="alias-item">
            <div class="alias-head"><strong>{alias.label}</strong><span>{[alias.language, humanizeKey(alias.alias_type)].filter(Boolean).join(' · ')}</span></div>
            {alias.scope_note && <p>{alias.scope_note}</p>}
          </div>)}</div>
        </div>}
      </section>}

      {hasSources && <section id="sources">
        <h2>Sources</h2>
        {term.interpretations.map((item)=><div class="source-block">
          <div class="source-head"><h3>{item.author_name} · <em>{item.work_title}</em></h3></div>
          <p>{item.summary}</p>
          {item.citations.map((citation)=><p class="source-cite">{citationLabel(citation)}{citation.edition_label ? ` · ${citation.edition_label}` : ''}</p>)}
        </div>)}
      </section>}

      {hasRelations && <section id="related">
        <h2>Related concepts</h2>
        <div class="relation-list">{term.relations.map((relation)=><div class="relation-item">
          <a href={`/terms/${relation.target_slug}/`}>{relation.target_label}</a>
          <span class="relation-type">{relationLabel(relation)}</span>
          {relation.note && <p>{relation.note}</p>}
        </div>)}</div>
      </section>}
    </article>

    <aside class="toc">
      <strong>On this entry</strong>
      {hasComposition
        ? pageComposition.map((publicSection)=><a href={`#section-${publicSection.section_key}`}>{publicSection.heading}</a>)
        : articleBlocks.map((block)=><a href={`#${block.type === 'table' ? block.table_key : block.section_key}`}>{block.heading}</a>)}
      {firstFamilyId && <a href={`#${firstFamilyId}`}>Concept family</a>}
      {hasLotDiagram && <a href="#lot-diagram">Lot construction</a>}
      {hasPlanetaryOrderDiagram && <a href="#planetary-order-diagram">Planetary order</a>}
      {hasPlanetaryTimeSequences && <a href="#planetary-time-sequences">Planetary days / hours</a>}
      {hasZodiacRelations && <a href="#zodiac-relations">Zodiac relations</a>}
      {hasAstronomyDiagram && <a href="#astronomy-diagram">Geometry / visual</a>}
      {hasZodiacSignProfile && <a href="#sign-profile">Zodiac sign profile</a>}
      {hasPlanetProfile && <a href="#planet-profile">Planet profile</a>}
      {firstReferenceId && <a href={`#${firstReferenceId}`}>Reference tables</a>}
      {firstCycleId && <a href={`#${firstCycleId}`}>Synodic cycle</a>}
      {hasNames && <a href="#names">Names & forms</a>}
      {hasSources && <a href="#sources">Sources</a>}
      {hasRelations && <a href="#related">Related concepts</a>}
    </aside>
  </div>
</BaseLayout>

<style>
  .title-row{display:flex;align-items:baseline;gap:1rem}
  .title-row h1{margin-right:0}
  .entry-glyph{font-size:clamp(2rem,5vw,4rem);line-height:1;font-family:var(--glyph-font,"DejaVu Sans","Noto Sans Symbols 2","Segoe UI Symbol",sans-serif);color:var(--muted);font-weight:400}
  .article-intro{max-width:52rem;margin:2.2rem 0 0;font-size:1.05rem}.article-intro p{margin:0}
  .composed-flow{max-width:58rem}.composed-block{max-width:52rem;margin:.85rem 0}.composed-block p{margin:.45rem 0}
  .composed-block.subsection{margin-top:1.55rem}.composed-block h3{margin:0 0 .45rem;font-size:1.05rem;font-weight:650}
  .composed-table-block{max-width:58rem;margin:1rem 0 1.35rem}.composed-table-block .table-caption{margin:0 0 .65rem}
  .alias-group{margin-top:1.2rem}.alias-group h3{font-size:1rem;margin-bottom:.7rem}
  .alias-list,.relation-list{display:grid;gap:.65rem;max-width:52rem}
  .alias-item,.relation-item{border-top:1px solid var(--line);padding:.7rem 0 .2rem}
  .alias-head{display:flex;align-items:baseline;gap:.7rem;flex-wrap:wrap}.alias-head span,.relation-type{font:600 .68rem/1.35 var(--font-ui,ui-sans-serif,system-ui,sans-serif);text-transform:uppercase;letter-spacing:.055em;color:var(--muted)}
  .alias-item p,.relation-item p{margin:.3rem 0 .2rem;color:var(--muted);font-size:.9rem;max-width:44rem}
  .relation-item>a{font-weight:650}.relation-type{display:block;margin-top:.15rem}
  .table-caption{margin:-.25rem 0 1rem;color:var(--muted);font-size:.92rem;max-width:42rem}
  .table-scroll{overflow-x:auto;border:1px solid var(--line-dark);background:var(--paper-pale)}
  .article-table{width:100%;border-collapse:collapse;min-width:34rem;font-size:.91rem}
  .article-table th,.article-table td{padding:.78rem .85rem;text-align:left;vertical-align:top;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
  .article-table th:last-child,.article-table td:last-child{border-right:0}
  .article-table tbody tr:last-child td{border-bottom:0}
  .article-table th{font:700 .68rem/1.35 var(--font-ui,ui-sans-serif,system-ui,sans-serif);text-transform:uppercase;letter-spacing:.07em;background:var(--paper-deep);white-space:nowrap}
  .article-table td:first-child{font-weight:600}
  .table-scroll:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  @media(max-width:720px){.article-table{min-width:30rem}.article-table th,.article-table td{padding:.68rem .72rem}.entry-glyph{font-size:2.4rem}.article-intro{margin-top:1.7rem}}
</style>